[gd_resource type="Resource" script_class="TriggerRule" load_steps=4 format=3]

[ext_resource type="Script" path="res://data_model/trigger_rule.gd" id="1_rule"]
[ext_resource type="Script" path="res://data_model/rule_condition.gd" id="2_cond"]

[sub_resource type="Resource" id="c_mil"]
script = ExtResource("2_cond")
world_var_path = &"org.self.ideology.militarism_pacifism"
op = 0
threshold = 0.45
describe_as = "高まる主戦論"

[sub_resource type="Resource" id="c_legit"]
script = ExtResource("2_cond")
world_var_path = &"org.self.legitimacy"
op = 1
threshold = 0.62
describe_as = "威信の回復"

[resource]
script = ExtResource("1_rule")
rule_id = &"militarist_conflict"
rule_type = 2
applies_to_kind = 3
applies_to_archetypes = Array[StringName]([])
conditions = Array[Resource]([SubResource("c_mil"), SubResource("c_legit")])
cooldown_ticks = 700
priority = 20
chance_per_tick = 0.05
chronicle_template = "{reason}をめぐり、{a}と{b}が公然と対立した。"

[gd_resource type="Resource" script_class="TriggerRule" load_steps=3 format=3]

[ext_resource type="Script" path="res://data_model/trigger_rule.gd" id="1_rule"]
[ext_resource type="Script" path="res://data_model/rule_condition.gd" id="2_cond"]

[sub_resource type="Resource" id="c_drift"]
script = ExtResource("2_cond")
world_var_path = &"org.self.ideology_drift"
op = 0
threshold = 0.24
describe_as = "建国の理念からの逸脱"

[resource]
script = ExtResource("1_rule")
rule_id = &"ideological_split_polity"
rule_type = 0
applies_to_kind = 3
applies_to_archetypes = Array[StringName]([])
conditions = Array[Resource]([SubResource("c_drift")])
cooldown_ticks = 900
priority = 30
chance_per_tick = 0.05
schism_kind = &"ideological_split"
branch_archetype_id = &""
inherited_member_fraction = Vector2(0.2, 0.45)
ideology_drift_bias = {
"centralization": -0.35,
"tradition_reform": -0.5
}
min_parent_members = 25
max_instances_of_archetype = 0
chronicle_template = "{reason}を認めぬ者たちが{parent}を離れ、{leader}のもと{branch}を称した。"

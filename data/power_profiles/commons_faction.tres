[gd_resource type="Resource" script_class="PowerProfile" load_steps=5 format=3]

[ext_resource type="Script" path="res://data_model/power_profile.gd" id="1_profile"]
[ext_resource type="Script" path="res://data_model/power_driver.gd" id="2_driver"]

[sub_resource type="Resource" id="drv_pop"]
script = ExtResource("2_driver")
world_var_path = &"global_population"
weight = 24.0
expected_max = 8000.0
invert = false
label = "民の数"

[sub_resource type="Resource" id="drv_unrest"]
script = ExtResource("2_driver")
world_var_path = &"world.settlements.avg_unrest"
weight = 24.0
expected_max = 0.7
invert = false
label = "民の不満"

[resource]
script = ExtResource("1_profile")
archetype_id = &"commons_faction"
display_label = "民衆派"
drivers = Array[Resource]([SubResource("drv_pop"), SubResource("drv_unrest")])
max_score = 100.0
base_score = 6.0
membership_weight = 0.3
monster_suppression_factor = 0.0
rank_sensitivity = 0.10
default_leadership_title = "代表"
noun_bank = Array[String](["民衆派", "市民派"])

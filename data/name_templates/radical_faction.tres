[gd_resource type="Resource" script_class="NameTemplate" load_steps=2 format=3]

[ext_resource type="Script" path="res://data_model/name_template.gd" id="1_template"]

[resource]
script = ExtResource("1_template")
applies_to_kind = 2
archetype_filter = Array[StringName]([&"levellers_faction", &"millenarian_faction", &"war_junta_faction", &"free_city_faction", &"technocrat_faction"])
name_pattern = "{noun}"
description_pattern = "{ideology}を掲げ、旧来の秩序を認めない。"
branch_name_pattern = "{noun}"
branch_description_pattern = "{parent}を否定して生まれた。イデオロギー:{ideology}"
word_bank = {}

[gd_resource type="Resource" script_class="NameTemplate" load_steps=2 format=3]

[ext_resource type="Script" path="res://data_model/name_template.gd" id="1_template"]

[resource]
script = ExtResource("1_template")
applies_to_kind = 2
archetype_filter = Array[StringName]([])
name_pattern = "{noun}"
description_pattern = "{adjective}{legitimacy}を掲げる派閥。イデオロギー:{ideology}"
branch_name_pattern = "{epithet}{noun}"
branch_description_pattern = "{parent}より分かれた派閥。イデオロギー:{ideology}"
word_bank = {
"epithet": ["新", "急進", "穏健", "真", "第二"]
}
